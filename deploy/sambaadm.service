[Unit]
Description=sambaadm — Samba4 AD administration
After=network.target samba-ad-dc.service
Wants=samba-ad-dc.service

[Service]
Type=simple
User=sambaadm
Group=sambaadm
EnvironmentFile=/etc/sambaadm/env
ExecStartPre=+/usr/local/libexec/sambaadm-prepare-logs
ExecStart=/usr/local/bin/sambaadm serve --config /etc/sambaadm/config.yaml
Restart=on-failure
RestartSec=5
LimitCORE=0
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=sambaadm
ReadWritePaths=/var/lib/sambaadm /var/log/sambaadm
PrivateTmp=true

[Install]
WantedBy=multi-user.target
