#!/usr/bin/python3
"""Root-only adapter for fence-agent passwd_script; never exposed through HTTP."""
import json, os, pathlib, re, stat, sys
if os.geteuid()!=0 or len(sys.argv)!=2:raise SystemExit(1)
path=pathlib.Path(sys.argv[1])
if not path.is_absolute() or not re.fullmatch(r'[a-z0-9][a-z0-9-]{0,63}\.json',path.name) or path.parent.name!='vault' or path.parent.parent.name!='filecluster':raise SystemExit(1)
try:
 directory=os.open(path.parent,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW)
 parent=os.fstat(directory)
 if parent.st_uid!=0 or parent.st_mode&0o077:raise SystemExit(1)
 fd=os.open(path.name,os.O_RDONLY|os.O_NOFOLLOW,dir_fd=directory)
 os.close(directory)
 info=os.fstat(fd)
 if not stat.S_ISREG(info.st_mode) or info.st_uid!=0 or info.st_mode&0o077 or info.st_nlink!=1 or info.st_size>16384:raise SystemExit(1)
 with os.fdopen(fd) as source:value=json.load(source)
 if value.get('kind')!='fence' or not isinstance(value.get('password'),str) or any(c in value['password'] for c in '\r\n\x00'):raise SystemExit(1)
 sys.stdout.write(value['password']+'\n')
except (OSError,ValueError,KeyError):raise SystemExit(1)
