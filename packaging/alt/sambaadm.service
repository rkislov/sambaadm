[Unit]
Description=sambaadm — Samba AD administration
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=sambaadm
Group=sambaadm
EnvironmentFile=/etc/sambaadm/env
WorkingDirectory=/var/lib/sambaadm
ExecStartPre=/usr/bin/sambaadm --config /etc/sambaadm/config.yaml version
ExecStart=/usr/bin/sambaadm --config /etc/sambaadm/config.yaml serve
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sambaadm /var/log/sambaadm
PrivateTmp=true

[Install]
WantedBy=multi-user.target
